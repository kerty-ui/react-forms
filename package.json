{
  "name": "@kerty-ui/react-forms",
  "author": "Armands Uiska",
  "description": "A React library for building controlled forms with ease and flexibility.",
  "version": "1.0.0",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "npm run dev:wiki",
    "dev:wiki": "vite --config vite.wiki.config.ts",
    "build": "npm run build:lib && npm run build:wiki",
    "build:types": "tsc -p ./tsconfig.lib.json",
    "build:lib": "vite build --config vite.lib.config.ts && npm run build:types",
    "build:wiki": "vite build --config vite.wiki.config.ts",
    "preview": "vite preview --config vite.wiki.config.ts",
    "prepack": "npm run build:lib && clean-package",
    "postpack": "clean-package restore"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@fortawesome/fontawesome-svg-core": "7.2.0",
    "@fortawesome/free-regular-svg-icons": "7.2.0",
    "@fortawesome/free-solid-svg-icons": "7.2.0",
    "@fortawesome/react-fontawesome": "3.3.1",
    "@tailwindcss/postcss": "4.3.0",
    "@tailwindcss/vite": "4.3.0",
    "@testing-library/react": "16.3.2",
    "@types/node": "25.9.1",
    "@types/react": "19.2.15",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitest/coverage-v8": "4.1.7",
    "autoprefixer": "10.5.0",
    "clean-package": "2.2.0",
    "jsdom": "29.1.1",
    "postcss": "8.5.15",
    "prism-react-renderer": "2.4.1",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-router": "7.16.0",
    "tailwind-merge": "3.6.0",
    "tailwindcss": "4.3.0",
    "tailwindcss-animate": "1.0.7",
    "typescript": "6.0.3",
    "vite": "8.0.14",
    "vitest": "4.1.7"
  },
  "clean-package": {
    "remove": [
      "scripts",
      "devDependencies",
      "clean-package"
    ]
  }
}
